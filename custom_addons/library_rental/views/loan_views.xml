<odoo>
    <record id="view_library_loan_list" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="copy_id"/>
                <field name="book_id"/>
                <field name="book_author"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Loan">
                            <field name="copy_id"/>
                            <field name="member_id"/>
                            <field name="loan_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                            <field name="state"/>
                        </group>
                        <group string="Copy and book">
                            <field name="copy_inventory_number"/>
                            <field name="copy_condition"/>
                            <field name="book_id"/>
                            <field name="book_author"/>
                            <field name="book_isbn"/>
                            <field name="book_publish_year"/>
                        </group>
                        <group string="Member">
                            <field name="member_name"/>
                            <field name="membership_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_loan"
              name="Loans"
              parent="menu_library_root"
              action="action_library_loan"
              sequence="20"/>
</odoo>
